# ==========================================
# VocabFlow Backend Environment & Credentials
# ==========================================

# Application Port & Environment
PORT=3000
NODE_ENV=development

# JWT Credentials
# Secret key used for signing and verifying JSON Web Tokens
JWT_SECRET=your_secure_random_jwt_secret_key_here

# MongoDB Database Credentials
# Connection string for local MongoDB or MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/vocabflow

# Neo4j Graph Database Credentials
# Connection URI, Username, and Password for Neo4j local or Neo4j Aura
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Dev/Testing Flags
# Set to true to bypass Neo4j graph operations in local environments where Neo4j is not running
SKIP_NEO4J=false

# Algorithm Configuration
SIMILARITY_THRESHOLD=0.75
